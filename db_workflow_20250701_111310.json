{
  "id": 1,
  "name": "Best Plan Pro Insurance Quote",
  "automation_sequence": [
    {
      "url": "https://v2preview.online.bestplanpro.com/",
      "action": "navigate",
      "description": "Open Best Plan Pro website"
    },
    {
      "action": "click",
      "selector": "#12450054977295322368",
      "wait_for": "Dialog to disappear",
      "description": "Click Accept button on EULA dialog",
      "alternative_selectors": [
        "name:Accept,role:Group >> name:Accept"
      ]
    },
    {
      "value": "01/15/1985",
      "action": "fill_input",
      "selector": "name:Date of Birth",
      "description": "Enter date of birth",
      "clear_before": true
    },
    {
      "action": "click",
      "selector": "name:Male",
      "description": "Select Male radio button"
    },
    {
      "value": "180",
      "action": "fill_input",
      "selector": "name:Weight (lbs)",
      "description": "Enter weight in pounds",
      "clear_before": true
    },
    {
      "action": "click",
      "selector": "name:Never",
      "description": "Select Never for nicotine usage"
    },
    {
      "value": "California",
      "action": "fill_input",
      "selector": "name:State",
      "description": "Enter state"
    },
    {
      "value": "90210",
      "action": "fill_input",
      "selector": "name:Zip Code",
      "description": "Enter zip code",
      "clear_before": true
    },
    {
      "value": "250000",
      "action": "fill_input",
      "selector": "name:Face Value ($)",
      "description": "Enter coverage amount",
      "clear_before": true
    },
    {
      "action": "click",
      "selector": "#9116875023776272252",
      "description": "Select Term life insurance product",
      "alternative_selectors": [
        "name:Term"
      ]
    },
    {
      "action": "click",
      "selector": "#14493993113991611727",
      "description": "Select No for open enrollment",
      "alternative_selectors": [
        "name:No"
      ]
    },
    {
      "value": "5'10\"",
      "action": "fill_input",
      "selector": "#16783872191045950436",
      "description": "Enter height - will trigger health wizard",
      "clear_before": true,
      "alternative_selectors": [
        "name:Height"
      ]
    },
    {
      "action": "click",
      "selector": "#16251652239921112986",
      "wait_after": 500,
      "description": "Cancel health wizard dialog",
      "alternative_selectors": [
        "name:Cancel"
      ]
    },
    {
      "action": "click",
      "selector": "#17517999067772859239",
      "description": "Click Run Quote button to generate quotes",
      "alternative_selectors": [
        "name:Run Quote"
      ]
    },
    {
      "action": "wait_for_element",
      "timeout": 60000,
      "selector": "name:Quote Results",
      "description": "Wait for quote results to load (up to 60 seconds)"
    }
  ],
  "validation_checks": [
    {
      "name": "EULA accepted",
      "type": "element_check",
      "selector": "!name:End-User License Agreement"
    },
    {
      "name": "Form filled",
      "type": "form_validation",
      "required_fields": [
        "Date of Birth: has value",
        "Sex: Male selected",
        "Weight: has value",
        "Height: has value",
        "State: has value",
        "Zip Code: has value",
        "Face Value: has value",
        "Product Type: Term selected",
        "Open Enrollment: No selected"
      ]
    },
    {
      "name": "Quote running",
      "type": "element_check",
      "selector": "name:Please wait..."
    },
    {
      "name": "Results displayed",
      "type": "element_check",
      "selector": "name:Quote Results"
    }
  ],
  "error_handling": [
    {
      "error_condition": "EULA dialog blocks interaction",
      "recovery_actions": [
        {
          "action": "retry",
          "description": "Click Accept button again"
        }
      ]
    },
    {
      "error_condition": "Health wizard appears",
      "recovery_actions": [
        {
          "action": "click",
          "description": "Click Cancel button (#16251652239921112986)"
        }
      ]
    },
    {
      "error_condition": "Run Quote button disabled",
      "recovery_actions": [
        {
          "action": "verify",
          "description": "All required fields are filled"
        }
      ]
    },
    {
      "error_condition": "Quote takes too long",
      "recovery_actions": [
        {
          "action": "wait",
          "description": "Up to 60 seconds"
        },
        {
          "action": "fallback",
          "description": "Refresh and retry entire sequence"
        }
      ]
    }
  ]
}