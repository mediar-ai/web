# Database Configuration (required)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional Configuration
RUST_LOG=info
PORT=8080
MCP_ENDPOINT=http://localhost:3000

# Auth token for the terminator-mcp-agent running on each VM (required at runtime).
# Shared secret; must match the token the agent is started with on the VM.
MCP_AUTH_TOKEN=your_mcp_auth_token_here

# GitHub Token (for workflow loading)
GITHUB_TOKEN=your_github_token_here

# Supabase Storage (for screenshot uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Monitor API Configuration (for alert notifications)
APP_URL=https://app.mediar.ai
MEDIAR_SERVICE_API_KEY=your_service_api_key_here

# Sentry Configuration (optional)
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_DEBUG=
ENVIRONMENT=production
