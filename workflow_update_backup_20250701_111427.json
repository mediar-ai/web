{
  "automation_sequence": [
    {
      "step_number": 1,
      "action": "navigate",
      "description": "Navigate to Best Plan Pro website",
      "selector": null,
      "url": "https://v2preview.online.bestplanpro.com/",
      "expected_result": "Chrome browser opens with Best Plan Pro website"
    },
    {
      "step_number": 2,
      "action": "wait_for_element",
      "description": "Wait for EULA window to appear",
      "selector": "role:Window",
      "timeout": 5000,
      "condition": "exists",
      "expected_result": "EULA window is visible"
    },
    {
      "step_number": 3,
      "action": "click",
      "description": "Click Accept button on EULA",
      "selector": "#12450054977295322368",
      "timeout": 3000,
      "expected_result": "EULA dialog is dismissed"
    },
    {
      "step_number": 5,
      "action": "fill_input",
      "description": "Fill in height field (triggers software registration)",
      "selector": "#16783872191045950436",
      "value": "70",
      "clear_before": true,
      "expected_result": "Height field populated and software registration dialog appears"
    },
    {
      "step_number": 6,
      "action": "wait_for_element",
      "description": "Wait for Software Registration dialog",
      "selector": "role:Text|name:Software Registration",
      "timeout": 5000,
      "condition": "exists",
      "expected_result": "Software Registration dialog is visible"
    },
    {
      "step_number": 7,
      "action": "fill_input",
      "description": "Enter Order ID",
      "selector": "#13604283145638815416",
      "value": "4WV-HJR-SA9",
      "clear_before": true,
      "expected_result": "Order ID entered"
    },
    {
      "step_number": 8,
      "action": "fill_input",
      "description": "Enter Email Address",
      "selector": "#14651589766163622092",
      "value": "louis@mediar.ai",
      "clear_before": true,
      "expected_result": "Email address entered"
    },
    {
      "step_number": 9,
      "action": "click",
      "description": "Click Activate button",
      "selector": "#3642970754128452067",
      "timeout": 3000,
      "expected_result": "Software is activated"
    },
    {
      "step_number": 10,
      "action": "wait_for_element",
      "description": "Wait for success message",
      "selector": "role:Button|name:OK",
      "timeout": 5000,
      "condition": "exists",
      "expected_result": "Success message appears"
    },
    {
      "step_number": 11,
      "action": "click",
      "description": "Click OK on success message",
      "selector": "role:Button|name:OK",
      "timeout": 3000,
      "expected_result": "Success message dismissed"
    },
    {
      "step_number": 12,
      "action": "fill_input",
      "description": "Fill in height field again after registration",
      "selector": "#16783872191045950436",
      "value": "70",
      "clear_before": true,
      "expected_result": "Height field populated"
    },
    {
      "step_number": 13,
      "action": "fill_input",
      "description": "Fill in Date of Birth",
      "selector": "#14662394201609357334",
      "value": "01/15/1985",
      "clear_before": true,
      "expected_result": "Date of Birth entered"
    },
    {
      "step_number": 14,
      "action": "fill_input",
      "description": "Fill in Weight",
      "selector": "#18191819271730191548",
      "value": "180",
      "clear_before": true,
      "expected_result": "Weight entered"
    },
    {
      "step_number": 15,
      "action": "click",
      "description": "Select Male radio button (using set_selected for reliability)",
      "selector": "#4137124105991473885",
      "timeout": 3000,
      "state": true,
      "alternative_selectors": [
        "role:RadioButton|name:Male"
      ],
      "expected_result": "Male radio button selected"
    },
    {
      "step_number": 16,
      "action": "fill_input",
      "description": "Fill in State",
      "selector": "#677755112996739582",
      "value": "California",
      "clear_before": true,
      "expected_result": "State entered"
    },
    {
      "step_number": 17,
      "action": "fill_input",
      "description": "Fill in Zip Code",
      "selector": "#9188373975606501900",
      "value": "90210",
      "clear_before": true,
      "expected_result": "Zip Code entered"
    },
    {
      "step_number": 18,
      "action": "click",
      "description": "Select No for Open Enrollment (using set_selected)",
      "selector": "#14493993113991611727",
      "timeout": 3000,
      "state": true,
      "alternative_selectors": [
        "role:RadioButton|name:No"
      ],
      "expected_result": "No radio button selected"
    },
    {
      "step_number": 19,
      "action": "fill_input",
      "description": "Fill in Face Value",
      "selector": "#4233704881078076887",
      "value": "$100,000",
      "clear_before": true,
      "alternative_selectors": [
        "role:Edit|name:Face Value"
      ],
      "expected_result": "Face Value entered",
      "note": "Updated with correct element ID"
    },
    {
      "step_number": 20,
      "action": "click",
      "description": "Close health wizard dialog if it appears",
      "selector": "#16251652239921112986",
      "timeout": 3000,
      "alternative_selectors": [
        "role:Group|name:Cancel"
      ],
      "optional": true,
      "expected_result": "Health wizard dialog closed",
      "note": "Changed to invoke_element for better reliability"
    },
    {
      "step_number": 21,
      "action": "wait",
      "description": "Wait before clicking Run Quote button",
      "selector": null,
      "wait_after": 2000,
      "expected_result": "Brief pause to ensure UI is ready"
    },
    {
      "step_number": 22,
      "action": "click",
      "description": "Invoke Run Quote button",
      "selector": "#17517999067772859239",
      "timeout": 5000,
      "alternative_selectors": [
        "role:Group|name:Run Quote"
      ],
      "expected_result": "Quote generation begins",
      "note": "Updated selector to current working ID"
    },
    {
      "step_number": 23,
      "action": "wait",
      "description": "Wait before clicking Run Quote button",
      "selector": null,
      "wait_after": 40000,
      "expected_result": "Brief pause to ensure UI is ready"
    },
    {
      "step_number": 24,
      "action": "wait_for_element",
      "description": "Wait for quote results to load",
      "selector": "role:Text|name:Top Recommendations",
      "timeout": 65000,
      "condition": "exists",
      "alternative_selectors": [
        "role:Text|name:Monthly Price"
      ],
      "expected_result": "Quote results are displayed",
      "note": "Updated selector to wait for actual results indicator"
    },
    {
      "step_number": 25,
      "action": "extract_data",
      "description": "Capture UI tree to extract quote results",
      "selector": null,
      "expected_result": "Full UI tree with quote results captured"
    }
  ],
  "validation_checks": [
    {
      "name": "EULA accepted",
      "type": "element_check",
      "selector": "!name:End-User License Agreement"
    },
    {
      "name": "Form filled",
      "type": "form_validation",
      "required_fields": [
        "Date of Birth: has value",
        "Sex: Male selected",
        "Weight: has value",
        "Height: has value",
        "State: has value",
        "Zip Code: has value",
        "Face Value: has value",
        "Product Type: Term selected",
        "Open Enrollment: No selected"
      ]
    },
    {
      "name": "Quote running",
      "type": "element_check",
      "selector": "name:Please wait..."
    },
    {
      "name": "Results displayed",
      "type": "element_check",
      "selector": "name:Quote Results"
    }
  ],
  "error_handling": [
    {
      "error_condition": "EULA dialog blocks interaction",
      "recovery_actions": [
        {
          "action": "retry",
          "description": "Click Accept button again"
        }
      ]
    },
    {
      "error_condition": "Health wizard appears",
      "recovery_actions": [
        {
          "action": "click",
          "description": "Click Cancel button (#16251652239921112986)"
        }
      ]
    },
    {
      "error_condition": "Run Quote button disabled",
      "recovery_actions": [
        {
          "action": "verify",
          "description": "All required fields are filled"
        }
      ]
    },
    {
      "error_condition": "Quote takes too long",
      "recovery_actions": [
        {
          "action": "wait",
          "description": "Up to 60 seconds"
        },
        {
          "action": "fallback",
          "description": "Refresh and retry entire sequence"
        }
      ]
    }
  ]
}