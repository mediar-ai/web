      "type": "added",
      "path": "arguments.variables.quote_parser",
      "new_value": {
        "type": "object",
        "label": "Quote Results Parser",
        "default": {
          "itemContainerDefinition": {
            "nodeConditions": [
              {
                "property": "role",
                "op": "equals",
                "value": "Group"
              }
            ],
            "childConditions": {
              "logic": "and",
              "conditions": [
                {
                  "existsChild": {
                    "conditions": [
                      {
                        "property": "role",
                        "op": "equals",
                        "value": "Image"
                      }
                    ]
                  }
                },
                {
                  "existsChild": {
                    "conditions": [
                      {
                        "property": "name",
                        "op": "contains",
                        "value": ":"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "fieldsToExtract": {
            "carrierProduct": {
              "fromChild": {
                "conditions": [
                  {
                    "property": "name",
                    "op": "contains",
                    "value": ":"
                  }
                ],
                "extractProperty": "name"
              }
            },
            "quoteValue": {
              "fromChild": {
                "conditions": [
                  {
                    "property": "name",
                    "op": "startsWith",
                    "value": "$"
                  }
                ],
                "extractProperty": "name"
              }
            },
            "quoteType": {
              "fromChild": {
                "conditions": [
                  {
                    "property": "name",
                    "op": "isOneOf",
                    "value": [
                      "Monthly Price",
                      "Death Benefit"
                    ]
                  }
                ],
                "extractProperty": "name"
              }
            },
            "status": {
              "fromChildren": {
                "conditions": [
                  {
                    "property": "role",
                    "op": "equals",
                    "value": "Text"
                  },
                  {
                    "property": "name",
                    "op": "isOneOf",
                    "value": [
                      "Graded",
                      "Discontinued",
                      "Standard",
                      "ROP"
                    ]
                  }
                ],
                "extractProperty": "name",
                "joinWith": ", "
              }
            }
          }
        }
      }
    },
