# Set default line endings behavior
* text=auto

# Shell scripts should use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Rust/Cargo files - use LF line endings
*.toml text eol=lf
*.rs text eol=lf
Cargo.lock text eol=lf

# Web development files - use LF line endings
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.cjs text eol=lf
*.cts text eol=lf
*.d.ts text eol=lf
*.d.mts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Tauri config filter - auto-converts dev/prod values
# Run: apps/desktop/scripts/setup-git-filters.ps1 to configure
apps/desktop/src-tauri/tauri.conf.json filter=tauri-config
