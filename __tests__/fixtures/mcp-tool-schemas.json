[
  {
    "name": "click_element",
    "description": "Click on a UI element",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "description": "Element selector"
        },
        "button": {
          "anyOf": [
            { "const": "left" },
            { "const": "right" },
            { "const": "middle" }
          ],
          "description": "Mouse button to click"
        },
        "click_count": {
          "type": "integer",
          "default": 1
        }
      },
      "required": ["selector"],
      "definitions": {
        "ButtonType": {
          "type": "string",
          "enum": ["left", "right", "middle"]
        }
      }
    }
  },
  {
    "name": "execute_sequence",
    "description": "Execute a sequence of workflow steps",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowStep"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "definitions": {
        "WorkflowStep": {
          "type": "object",
          "properties": {
            "tool_name": { "type": "string" },
            "arguments": { "type": "object" }
          },
          "required": ["tool_name", "arguments"]
        }
      }
    }
  },
  {
    "name": "type_into_element",
    "description": "Type text into an element",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "selector": { "type": "string" },
        "text_to_type": { "type": "string" },
        "press_enter_after": {
          "anyOf": [
            { "type": "boolean" },
            { "const": null }
          ]
        }
      },
      "required": ["selector", "text_to_type"]
    }
  }
]
