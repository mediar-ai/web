            {
                "step": 22,
                "action": "invoke_element",
                "description": "Invoke Run Quote button",
                "selector": "#17517999067772859239",
                "alternative_selectors": "role:Group|name:Run Quote",
                "parameters": {
                    "timeout_ms": 5000
                },
                "expected_result": "Quote generation begins",
                "note": "Updated selector to current working ID"
            },
            {
                "step": 23,
                "action": "delay",
                "description": "Wait before clicking Run Quote button",
                "parameters": {
                    "delay_ms": 40000
                },
                "expected_result": "Brief pause to ensure UI is ready"
            },
            {
                "step": 24,
                "action": "wait_for_element",
                "description": "Wait for quote results to load",
                "selector": "role:Text|name:Top Recommendations",
                "alternative_selectors": "role:Text|name:Monthly Price",
                "parameters": {
                    "condition": "exists",
                    "timeout_ms": 65000
                },
                "expected_result": "Quote results are displayed",
                "note": "Updated selector to wait for actual results indicator"
            },
            {
                "step": 25,
                "action": "get_focused_window_tree",
                "description": "Capture UI tree to extract quote results",
                "parameters": {},
                "expected_result": "Full UI tree with quote results captured"
            }
        ],
        "improvements": [
            "Use invoke_element instead of click_element for buttons that may be out of viewport",
            "Use set_selected for radio buttons instead of click_element for better reliability",
            "Correct element IDs based on actual UI inspection",
            "Add JSON extraction step to capture structured quote results",
            "Include alternative selectors for fallback options",
            "Add delay between closing health wizard and running quote for UI stability",
            "Use get_focused_window_tree tool to automatically capture the currently focused window instead of manually specifying PID"
        ],
        "known_issues": [
            "Consumer Information group may not always be visible (marked as optional)",
            "Health wizard dialog may appear multiple times",
            "Page scrolling may affect element visibility for click operations",
            "Element IDs may change between sessions - use role|name selectors as fallback"
        ],
        "notes": [
            "Height field needs to be filled in inches (70 = 5'10\")",
            "Most insurance products show as ineligible for the test profile (40-year-old male, California)",
            "The workflow successfully completes and extracts JSON data with product recommendations",
            "Total execution time approximately 3-4 minutes including quote generation wait time"
        ]
    }
