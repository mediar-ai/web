{
    "workflow": {
        "name": "Best Plan Pro Insurance Quote Automation",
        "version": "2.0",
        "description": "Automates the process of generating life insurance quotes on Best Plan Pro Online v2 and extracts results as JSON",
        "goal": "Navigate to Best Plan Pro website, accept terms, fill out insurance form with dummy data, generate insurance quotes, and extract quote results as structured JSON data",
        "credentials": {
            "order_id": "4WV-HJR-SA9",
            "email": "louis@mediar.ai"
        },
        "prerequisites": [
