{
  "name": "mediar-app",
  "private": true,
  "version": "1.0.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:mcp": "cd ../terminator && git pull && cargo build -p terminator-mcp-agent && cp target/debug/terminator-mcp-agent.exe ../mediar-app/src-tauri/binaries/terminator-mcp-agent.exe && cp target/debug/terminator-mcp-agent.exe ../mediar-app/src-tauri/binaries/terminator-mcp-agent-x86_64-pc-windows-msvc.exe",
    "predev:tauri": "bun scripts/cleanup-dev.js",
    "dev:tauri": "tauri dev",
    "predev:tauri:inspect": "bun scripts/build-mcp.js",
    "dev:tauri:inspect": "tauri dev",
    "build": "tsc && vite build",
    "prebuild:tauri": "bun scripts/build-mcp.js",
    "build:tauri": "tauri build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration:tauri": "vitest run src/__tests__/integration",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=junit --reporter=json",
    "test:all": "npm run lint && npm run test:coverage && cd src-tauri && cargo test && cargo clippy -- -D warnings && cargo fmt --check",
    "test:integration": "cd mediar-mcp-testing && ./start-test.sh",
    "test:integration:mock": "cd mediar-mcp-testing && ./start-test.sh --mock",
    "test:integration:prompt": "cd mediar-mcp-testing && ./start-test.sh --prompt",
    "test:integration:real": "cd mediar-mcp-testing && ./start-test.sh --no-auto-start",
    "test:app:start": "cd mediar-mcp-testing && cargo run --bin tauri-app-manager -- start",
    "test:app:stop": "cd mediar-mcp-testing && cargo run --bin tauri-app-manager -- stop",
    "test:app:status": "cd mediar-mcp-testing && cargo run --bin tauri-app-manager -- status",
    "tauri": "tauri",
    "tauri:test": "cd src-tauri && cargo test",
    "tauri:lint": "cd src-tauri && cargo clippy -- -D warnings",
    "tauri:fmt": "cd src-tauri && cargo fmt",
    "tauri:fmt:check": "cd src-tauri && cargo fmt --check",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo src-tauri/target",
    "prepare": "husky install || true",
    "validate:workflows": "node -e \"const YAML=require('yaml'); const fs=require('fs'); const glob=require('glob'); glob.sync('workflows/*.yaml').forEach(f=>{ try { const text=fs.readFileSync(f,'utf8'); const doc=YAML.parse(text); if(!doc||doc.tool_name!=='execute_sequence'||!doc.arguments||!Array.isArray(doc.arguments.steps)) throw new Error('Not canonical execute_sequence'); console.log('✅', f);} catch(e){ console.error('❌', f, e.message); process.exit(1);} });\"",
    "test:e2e": "wdio run e2e/wdio.conf.cjs",
    "test:e2e:build": "tauri build --debug --no-bundle",
    "test:e2e:mcp": "node e2e/mcp-server.test.cjs",
    "test:e2e:ui": "bun e2e/ui-tests.ts",
    "test:e2e:all": "node e2e/mcp-server.test.cjs && bun e2e/ui-tests.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": "prettier --write"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/merge": "^6.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/react": "^9.40.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/api": "2.7.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-global-shortcut": "^2.0.1",
    "@tauri-apps/plugin-log": "2.6.0",
    "@tauri-apps/plugin-positioner": "~2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-window-state": "^2.0.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/vfs": "^1.6.2",
    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "framer-motion": "^11.0.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.263.1",
    "posthog-js": "^1.277.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^16.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.6",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mediar-ai/workflow": "^0.23.49",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.5.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@wdio/cli": "^9.21.1",
    "@wdio/local-runner": "^9.21.0",
    "@wdio/mocha-framework": "^9.21.0",
    "@wdio/spec-reporter": "^9.20.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jsdom": "^23.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.27",
    "prettier": "^3.7.3",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.4",
    "vitest": "^1.0.0"
  }
}
