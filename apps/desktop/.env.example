# Mediar Desktop App Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# API Configuration (Required)
# ===========================================

# Backend API URL
VITE_API_BASE_URL=https://app.mediar.ai
MEDIAR_API_URL=https://app.mediar.ai

# ===========================================
# AI Provider Keys (Required for AI features)
# ===========================================

# Anthropic Claude API Key (for AI chat features)
VITE_ANTHROPIC_API_KEY=

# Google Gemini API Key (for workflow recorder AI)
GEMINI_API_KEY=

# ===========================================
# Analytics (Optional - has defaults)
# ===========================================

# PostHog Analytics - Frontend (Vite)
# VITE_POSTHOG_API_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog Analytics - Backend (Rust/Tauri)
# POSTHOG_API_KEY=phc_xxx

# ===========================================
# Crisp Chat (Optional)
# ===========================================

# VITE_CRISP_WEBSITE_ID=

# ===========================================
# Tauri Signing (Required for release builds)
# ===========================================

# Generate with: bunx @tauri-apps/cli signer generate
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# TAURI_UPDATE_PUBLIC_KEY=

# ===========================================
# ClickHouse Analytics Backend (Optional)
# ===========================================

# CN_API_KEY=
