{
  "name": "@mediar/infra",
  "version": "0.1.0",
  "description": "Mediar infrastructure management - library and CLI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "mediar-infra": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./azure": {
      "import": "./dist/azure/index.mjs",
      "require": "./dist/azure/index.js",
      "types": "./dist/azure/index.d.ts"
    },
    "./telemetry": {
      "import": "./dist/telemetry/index.mjs",
      "require": "./dist/telemetry/index.js",
      "types": "./dist/telemetry/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint configured for infra'",
    "cli": "tsx src/cli/index.ts",
    "test": "bun test",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@azure/arm-compute": "^23.2.0",
    "@azure/arm-imagebuilder": "^4.0.0",
    "@azure/arm-network": "^36.0.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/identity": "^4.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "commander": "^14.0.2",
    "chalk": "^5.4.0",
    "ora": "^9.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mediar",
    "infrastructure",
    "azure",
    "cli",
    "opentelemetry"
  ],
  "author": "Mediar AI",
  "license": "MIT"
}
