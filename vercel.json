{
  "buildCommand": "npx turbo build --filter=@mediar/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "bun install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/scheduler",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/health-check-supabase",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-pending-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/llm-usage-reconciliation",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/llm-traces-cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/brex-sync",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/reactivation-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/freeze-billing-month",
      "schedule": "24 18 * * *"
    }
  ]
} 