{
  "functions": {
    "src/app/api/ingest/route.ts": {
      "maxDuration": 800
    },
    "src/app/api/suggest-workflow-labels/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/scheduler/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/health-check-supabase/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/process-pending-notifications/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/llm-usage-reconciliation/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/reactivation-emails/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/scheduler",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reactivation-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/health-check-supabase",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-pending-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/llm-usage-reconciliation",
      "schedule": "0 * * * *"
    }
  ]
} 