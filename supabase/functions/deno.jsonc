{
    "compilerOptions": {
      "lib": ["deno.ns", "dom"]
    },
    "lint": {
      "rules": {
        "exclude": ["no-explicit-any"]
      },
      "files": {
        "exclude": ["_shared/"]
      }
    },
    "fmt": {
      "options": {
        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 2,
        "singleQuote": true
      }
    }
  }