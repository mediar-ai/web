-- Drop the old, normalized tables
DROP TABLE IF EXISTS "public"."timeline_event_workflow_mappings";
DROP TABLE IF EXISTS "public"."timeline_event_unrelated";
DROP TABLE IF EXISTS "public"."workflow_instances";
DROP TABLE IF EXISTS "public"."workflow_types";

-- Create the new, single denormalized table for timeline annotations
CREATE TABLE "public"."timeline_event_annotations" (
    "id" bigint NOT NULL,
    "timeline_event_id" bigint NOT NULL,
    "is_workflow_related" boolean NOT NULL,
    "workflow_id" bigint,
    "workflow_type_name" text,
    "workflow_instance_name" text,
    "step_name" text,
    "substep_name" text,
    "inputs" text[],
    "outputs" text[],
    "business_logic" text[],
    "unrelated_reason" text,
    "confidence_score" real,
    "model_used" text,
    "user_id" uuid,
    "session_id" text,
    "created_at" timestamp with time zone DEFAULT now() NOT NULL,
    "updated_at" timestamp with time zone DEFAULT now() NOT NULL
);

-- Add comments to explain the purpose of each column
COMMENT ON COLUMN "public"."timeline_event_annotations"."timeline_event_id" IS 'The key link. Points to the original event in low_level_events.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."is_workflow_related" IS 'A simple flag to quickly determine if the event is part of a workflow or not.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."workflow_id" IS 'Points to the parent workflow in low_level_workflows.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."workflow_type_name" IS 'The name of the variation, e.g., "Standard Install". (Denormalized)';
COMMENT ON COLUMN "public"."timeline_event_annotations"."workflow_instance_name" IS 'The name of the specific execution, e.g., "Order #12345". (Denormalized)';
COMMENT ON COLUMN "public"."timeline_event_annotations"."step_name" IS 'The high-level step name, e.g., "Launch Installer".';
COMMENT ON COLUMN "public"."timeline_event_annotations"."substep_name" IS 'The granular sub-step name, e.g., "Execute Installer Command".';
COMMENT ON COLUMN "public"."timeline_event_annotations"."inputs" IS 'The specific inputs for this event''s action.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."outputs" IS 'The specific outputs for this event''s action.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."business_logic" IS 'The business rules relevant to this specific event''s action.';
COMMENT ON COLUMN "public"."timeline_event_annotations"."unrelated_reason" IS 'Explains why the event was irrelevant, e.g., "User switched to email."';

-- Set up the primary key
ALTER TABLE "public"."timeline_event_annotations" ALTER COLUMN "id" ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME "public"."timeline_event_annotations_id_seq"
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);
ALTER TABLE ONLY "public"."timeline_event_annotations" ADD CONSTRAINT "timeline_event_annotations_pkey" PRIMARY KEY ("id");

-- Add foreign key constraints
ALTER TABLE ONLY "public"."timeline_event_annotations" ADD CONSTRAINT "timeline_event_annotations_timeline_event_id_fkey" FOREIGN KEY (timeline_event_id) REFERENCES public.low_level_events(id) ON DELETE CASCADE;
ALTER TABLE ONLY "public"."timeline_event_annotations" ADD CONSTRAINT "timeline_event_annotations_workflow_id_fkey" FOREIGN KEY (workflow_id) REFERENCES public.low_level_workflows(id) ON DELETE SET NULL;
ALTER TABLE ONLY "public"."timeline_event_annotations" ADD CONSTRAINT "timeline_event_annotations_user_id_fkey" FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE;


-- Add indexes for performance
CREATE INDEX "idx_timeline_event_annotations_event_id" ON "public"."timeline_event_annotations" USING "btree" ("timeline_event_id");
CREATE INDEX "idx_timeline_event_annotations_user_id" ON "public"."timeline_event_annotations" USING "btree" ("user_id");
CREATE INDEX "idx_timeline_event_annotations_workflow_id" ON "public"."timeline_event_annotations" USING "btree" ("workflow_id");


-- Enable Row Level Security
ALTER TABLE "public"."timeline_event_annotations" ENABLE ROW LEVEL SECURITY;

-- Create RLS policies
CREATE POLICY "Users can view their own annotations" ON "public"."timeline_event_annotations" FOR SELECT USING ((auth.uid() = user_id));
CREATE POLICY "Users can insert their own annotations" ON "public"."timeline_event_annotations" FOR INSERT WITH CHECK ((auth.uid() = user_id));
CREATE POLICY "Users can update their own annotations" ON "public"."timeline_event_annotations" FOR UPDATE USING ((auth.uid() = user_id));
CREATE POLICY "Users can delete their own annotations" ON "public"."timeline_event_annotations" FOR DELETE USING ((auth.uid() = user_id)); 