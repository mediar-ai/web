# Sandbox Server Environment Variables
# Copy to .env and fill in values

# Port (default 3000)
PORT=3000

# User ID - baked in per sandbox
USER_ID=your_clerk_user_id

# Google Vertex AI (option 1: base64 JSON)
GOOGLE_APPLICATION_CREDENTIALS_BASE64=base64_encoded_service_account_json

# Google Vertex AI (option 2: individual fields)
# GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLOUD_PROJECT=mediar-394022
VERTEX_AI_LOCATION=us-central1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Redis (for session storage)
REDIS_URL=redis://...
