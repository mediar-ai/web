{
  "name": "browser-workflow-capture-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@mediar/web",
    "dev:desktop": "turbo dev:tauri --filter=mediar-app",
    "dev:infra": "turbo dev --filter=@mediar/infra",
    "dev:vm": "cd apps/desktop/apps/vm-dashboard && bun run dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@mediar/web",
    "build:desktop": "turbo build:tauri --filter=mediar-app",
    "build:infra": "turbo build --filter=@mediar/infra",
    "start": "bun run --filter=@mediar/web start",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check typecheck",
    "test": "turbo test",
    "test:web": "tsx apps/web/src/tests/run-tests.ts",
    "test:web:unit": "tsx apps/web/src/tests/unit-tests.test.ts",
    "test:desktop": "turbo test --filter=mediar-app",
    "test:mcp": "tsx apps/web/src/tests/run-tests.ts",
    "test:watch": "tsx --watch apps/web/src/tests/run-tests.ts",
    "test:ai-api": "tsx scripts/test-ai-api.ts",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rimraf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:turbo": "rimraf .turbo apps/*/.turbo packages/*/.turbo",
    "deploy:rust": "cd crates/executor && ./scripts/deploy.sh dev",
    "deploy:rust:prod": "cd crates/executor && ./scripts/deploy.sh prod",
    "deploy:rust:staging": "cd crates/executor && ./scripts/deploy.sh staging"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^3.0.87",
    "@ai-sdk/react": "^2.0.109",
    "@anthropic-ai/sdk": "^0.71.2",
    "@azure/arm-compute": "^23.2.0",
    "@azure/arm-imagebuilder": "^4.1.0",
    "@azure/arm-network": "^35.0.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/identity": "^4.13.0",
    "@clerk/nextjs": "^6.36.1",
    "@clickhouse/client": "^1.14.0",
    "@daytonaio/sdk": "^0.123.0",
    "@google-cloud/aiplatform": "^5.14.0",
    "@google-cloud/bigquery": "^8.1.1",
    "@google/genai": "^1.32.0",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "^0.24.6",
    "@mediar-ai/terminator": "^0.23.36",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.52.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-email/render": "^2.0.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/diff": "^8.0.0",
    "@types/jszip": "^3.4.1",
    "@types/pg": "^8.15.6",
    "@types/prismjs": "^1.26.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.10.0",
    "ai": "^5.0.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.9.0",
    "date-fns": "^4.1.0",
    "diff": "^8.0.2",
    "dot-case": "^4.0.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.25",
    "google-auth-library": "^10.5.0",
    "highlight.js": "^11.11.1",
    "inngest": "^3.47.0",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.0",
    "json-diff": "^1.0.6",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.12.2",
    "modal": "^0.5.6",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "playwright": "^1.52.0",
    "posthog-js": "^1.302.2",
    "posthog-node": "^5.17.2",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.5.1",
    "redis": "^5.10.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.10",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/apps/web/src/$1"
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.(test|spec).ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "apps/web/tsconfig.json"
        }
      ]
    }
  },
  "devDependencies": {
    "@clerk/backend": "^2.17.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.10",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "supabase": "^2.24.3",
    "svix": "^1.76.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "turbo": "^2.6.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
